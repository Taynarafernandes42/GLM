&time
   timefmt = 3
   start = '1996-01-01 00:00:00'
   stop  = '2014-12-29 23:00:00'
   dt = 3600
   num_days = 6937
   !timezone = 7.0
/
&output
   out_dir = './output_off'
   out_fn = 'output'
   nsave = 1
   csv_lake_fname = 'lake'
   csv_point_nlevs = 8
   csv_point_fname = 'Abovebottom'
   csv_point_at = 1, 5, 10, 18, 20, 25, 30, 35
   csv_point_nvars = 2
   csv_point_vars = 'temp', 'salt'
   csv_outlet_fname = 'outlet_timeseries.csv'
   csv_outlet_nvars = 6
   csv_outlet_vars  = 'flow','temp', 'salt', 'hbot', 'htop', 'flbc'
/
&init_profiles
    lake_depth = 48.49
    num_depths = 2
    the_depths =  0.10, 48.10
    ! GLM
    the_temps  = 8.2
    the_sals = 0.01
/
&meteorology
   met_sw     = .true.
   lw_type    = 'LW_CC'
   rain_sw    = .false.
   atm_stab   = 0
   !catchrain   = .true.
   !rad_mode    = 1
   !albedo_mode = 1
   cloud_mode  = 4
   fetch_mode = 0
   !-- BC file details
   subdaily   = .true.
   meteo_fl   = './met_hourly.csv'
   wind_factor = 0.78
   sw_factor = 1.0
   lw_factor = 1.0
   at_factor = 1.0
   rh_factor = 1.0
   rain_factor = 1.0
   !-- Parameters
   ce = 0.0013
   ch = 0.0013
   cd = 0.0013
   !rain_threshold = 0.001
   !runoff_coef    = 0.0
/
&light
   light_mode = 0
   n_bands = 4
   light_extc = 1.0, 0.5, 2.0, 4.0
   energy_frac = 0.51, 0.45, 0.035, 0.005
   Kw = 0.6
/
&bird_model
  AP = 973
  Oz = 0.279
  WatVap = 1.1
  AOD500 = 0.033
  AOD380 = 0.038
  Albedo = 0.2
/
&inflow
   num_inflows    = 4
   names_of_strms = 'heatpump', 'river', 'river2', 'river3'
   subm_flag      = .false., .false., .false., .false.
   !subm_elev      = 18.0, 0.0, 0.0, 0.0
   strm_hf_angle  = 80, 80, 80, 80
   strmbd_slope   = 0.5, 0.5, 0.5, 0.5
   strmbd_drag    = 0.016, 0.016, 0.016, 0.016
   inflow_factor  = 1, 1, 1, 1
   inflow_fl      = './inflow_heatpump.csv', './inflow_river.csv', './inflow_river2.csv','./inflow_river3.csv' 
   inflow_varnum  = 3,
   inflow_vars    = 'FLOW',
                    'TEMP',
                    'SALT'
   coef_inf_entrain = 0.0
/
&outflow
   num_outlet        = 3
   outlet_type       = 1, 1, 1
   outl_elvs         = 154.0, 154.0, 154.0
   !subm_elev_outflow = 25.0, 0.0, 0.0
   !elev_idx_outflow  = 3, 0, 0
   bsn_len_outl      = 4347, 3837, 3830
   bsn_wid_outl      = 520, 460, 450
   outflow_fl        = './outflow_off.csv', './outflow_1.csv', './outflow_3.csv'
   outflow_factor    = 1, 1, 1
/
